# Firebase config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Redirect URL for the main CTA
VITE_TARGET_URL=

# Background — flat colour fallback
VITE_BG_COLOR=#ffb524
VITE_TEXT_COLOR=#ff003c

# Background image (name only, no extension) from public/images/
# Leave empty to use VITE_BG_COLOR instead
# Used for a single static background — overridden if VITE_BG_LAYERS is set
VITE_USE_BG=

# Parallax background layers: comma-separated "name:depth" pairs
# Lower PX number = slower movement (farther back); higher = faster (closer to viewer)
# Mouse parallax on desktop; gyroscope tilt on mobile
# Leave empty to use VITE_USE_BG (single static background) instead
# Example: VITE_BG_LAYERS=PX01_LAYER:0.1,PX02_LAYER:0.4,PX03_LAYER:0.9
VITE_BG_LAYERS=

# Zoom scale applied to moving parallax layers to prevent edge bleed at max offset
# 1.05 = 5% larger; increase if layers clip at the edges during strong movement
VITE_BG_ZOOM=1.05

# Logo image (name only, no extension) from public/images/
# Leave empty to use the bundled fallback asset
VITE_LOGO_IMAGE=
VITE_LOGO_WIDTH=400px

# Character / decorative image (name only, no extension) from public/images/
# Wishlist button image (name only, no extension) from public/images/
# Clicking redirects to VITE_TARGET_URL unless VITE_WISHLIST_URL is set
VITE_WISHLIST_IMAGE=
VITE_WISHLIST_WIDTH=400px

# Vimeo video ID (numbers only from the Vimeo URL)
# Leave empty to hide the video block
VITE_VIMEO_ID=

# Optional text shown below the button. Leave empty to hide.
VITE_TEXT_BLOCK=

# Set to true to make the entire background clickable (redirects to VITE_TARGET_URL)
VITE_REDIRECT_ALL=false
